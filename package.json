{
  "name": "orion-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Orion AI — Asistente de escritorio con inteligencia artificial",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Orion AI"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build",
    "start": "node scripts/run-electron.js",
    "preview": "vite preview",
    "mobile:init": "npx cap init 'Orion AI' com.orionai.remote --web-dir mobile",
    "mobile:add": "npx cap add android",
    "mobile:sync": "npx cap sync android",
    "mobile:build": "npx cap sync android && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.0",
    "@ai-sdk/openai": "^1.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource/inter": "^5.1.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@types/ws": "^8.18.1",
    "ai": "^4.2.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "screenshot-desktop": "^1.15.6",
    "ws": "^8.21.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^31.2.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8"
  }
}
